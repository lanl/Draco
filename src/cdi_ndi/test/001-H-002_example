from sys import stdout
from ndvv.ndi2.ndicl import ndicl
from ndvv.utilities.string   import vector_to_text

tw_options = {
                        'width'                 :  132,
                        'initial_indent'        :  '',
                        'subsequent_indent'     :  ' ',
                        'expand_tabs'           :  True,
                        'replace_whitespace'    :  True,
                        'fix_sentence_endings'  :  True,
                        'break_long_words'      :  False,
                        'drop_whitespace'       :  True,
                        'break_on_hyphens'      :  False
}

n = ndicl(ndicl='/opt/local/codes/data/nuclear/ndi/2.0.14/x86_64-linux/bin/ndicl',gendir='./gendir')

n.set_zaid('1002')
n.get_string_val("NDI_ZAID")

ng = n.get_int_val("NDI_NUM_GRPS")

n.set_option("NDI_E_AVG", "from_td")
eavg = numpy.array( n.get_float_vec("NDI_E_AVG") )

kerma, kerma_njoy, p0, sec_parts = {}, {}, {}, []

n.set_option("NDI_KERMA", "use_data")
kerma_njoy['sum'] = numpy.array( n.get_float_vec("NDI_KERMA") )

p0['1'] = numpy.array( n.get_float_vec_n("NDI_PN_FULL",0) ).reshape([ng,ng]) # p0[ig,eg]

nsp = n.get_int_val("NDI_NUM_SEC_PARTS")
for i in range(nsp):
    sec_parts.append( n.get_string_val_n("NDI_SEC_PART_TYPES",i) )

for sp in sec_parts:
    n.set_option("NDI_CURR_PART",sp)
    ngs = ng
    if sp == '0':
        eb0 = numpy.array(n.get_float_vec("NDI_E_BOUNDS_CURR_PART"))
        eavg0 = numpy.array([ (eb0[i]+eb0[i+1])/2. for i in range(len(eb0)-1)  ])
        ng0 = len(eavg0)
        ngs = ng0
    p0[sp] = numpy.array( n.get_float_vec_n("NDI_PN_PROD_FULL_CURR_PART",0) ).reshape([ng,ngs]) # p0[ig,eg]
    kerma_njoy[sp] = numpy.array( n.get_float_vec("NDI_KERMA_CURR_PART") )

kerma['sum'] = numpy.zeros(ng)
for sp in sec_parts:
    ea = eavg
    if sp == '0':
        ea = eavg0
    kerma[sp] = numpy.array([sum(p0[sp][i,:]*ea) for i in range(ng)])
    kerma['sum'] += kerma[sp]

for i in range(ng):
    for sp in sec_parts:
        stdout.write(" %24s"%(sp))
    stdout.write("%24s %24s %24s\n"%('sum','njoy','s/n'))
    for sp in sec_parts:
        stdout.write(" %24r"%(kerma[sp][i]))
    stdout.write("%24r %24r %24r\n"%(kerma['sum'][i],kerma_njoy['sum'][i],kerma['sum'][i]/kerma_njoy['sum'][i]))

for sp in sec_parts:
    print "secpart", sp
    for i in range(ng):
        stdout.write("%24r %24r %24r\n"%(kerma[sp][i],kerma_njoy[sp][i],kerma[sp][i]-kerma_njoy[sp][i]))

print "kerma"
print vector_to_text(kerma['sum'],options=tw_options)

