{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 26,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-ninja",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}-$env{SLURM_CLUSTER_NAME}",
        "rhs": "Linux-"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "description": "Target Linux for Debug build.",
      "inherits": "linux-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "description": "Target Linux for Release build.",
      "inherits": "linux-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-debug-scalar",
      "displayName": "Linux Debug (No MPI)",
      "description": "Target Linux for Debug build.",
      "inherits": "linux-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DRACO_C4": "SCALAR",
        "DRACO_DIAGNOSTICS": "2"
      }
    },
    {
      "name": "linux-debug-fd-static",
      "displayName": "Linux Debug (Full Diagnostics, static libraries)",
      "description": "Target Linux for Debug build.",
      "inherits": "linux-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DRACO_DIAGNOSTICS": "7",
        "DRACO_TIMING": "1",
        "DRACO_LIBRARY_TYPE": "STATIC"
      }
    },
    {
      "name": "linux-debug-valgrind",
      "displayName": "Linux Debug (Valgrind memory analysis)",
      "description": "Target Linux for Debug build.",
      "inherits": "linux-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-march=broadwell",
        "CMAKE_Fortran_FLAGS": "-march=broadwell",
        "ENABLE_MEMORYCHECK": "ON",
        "CTEST_MEMORYCHECK_SUPPRESSIONS_FILE": "${sourceDir}/.gitlab/ci/valgrind_suppress.txt"
      }
    },
    {
      "name": "linux-debug-cxx20",
      "displayName": "Linux Debug with c++20 enabled",
      "description": "Target Linux for Debug build.",
      "inherits": "linux-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "Draco_CXX_LANGUAGE_STANDARD": "20"
      }
    },
    {
      "name": "linux-debug-clang-tidy",
      "displayName": "Linux Debug (Clang Tidy)",
      "description": "Target Linux for Debug build.",
      "inherits": "linux-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DRACO_STATIC_ANALYZER": "clang-tidy",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      },
      "condition": {
        "type": "matches",
        "string": "$env{CC}",
        "regex": "clang"
      }
    },
    {
      "name": "venado-ninja",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}-$env{SLURM_CLUSTER_NAME}",
        "rhs": "Linux-venado"
      }
    },
    {
      "name": "venado-debug",
      "displayName": "Venado Debug",
      "description": "Target Venado for Debug build.",
      "inherits": "venado-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "darwin-haswell",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}-$env{SLURM_JOB_PARTITION}",
      "installDir": "${sourceDir}/install/${presetName}-$env{SLURM_JOB_PARTITION}",
      "condition": {
        "type": "inList",
        "string": "$env{SLURM_CLUSTER_NAME}-$env{SLURM_JOB_PARTITION}",
        "list": [
          "darwin-general",
          "darwin-sid-spr"
        ]
      }
    },
    {
      "name": "darwin-haswell-debug",
      "displayName": "Darwin Debug",
      "description": "Target Linux for Debug build.",
      "inherits": "darwin-haswell",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "darwin-haswell-release",
      "displayName": "Darwin Release",
      "description": "Target Linux for Debug build.",
      "inherits": "darwin-haswell",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "darwin-haswell-clang-tidy",
      "displayName": "Darwin Debug (Clang Tidy)",
      "description": "Target Linux for Debug build.",
      "inherits": "darwin-haswell",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DRACO_STATIC_ANALYZER": "clang-tidy"
      }
    },
    {
      "name": "macos-debug",
      "displayName": "macOS Debug",
      "description": "Target a remote macOS system.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "windows-msbuild",
      "description": "Target Windows with the Visual Studio development environment.",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.gitlab/ci/vs2022-toolchain.cmake"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-ninja",
      "description": "Target Windows with Ninja",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "DRACO_LIBRARY_TYPE": "SHARED",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.gitlab/ci/vs2022-toolchain.cmake",
        "CMAKE_MAKE_PROGRAM": "C:/Program Files/Microsoft Visual Studio/2022/Professional/Common7/IDE/CommonExtensions/Microsoft/CMake/Ninja/ninja.exe"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "win-x64-debug",
      "displayName": "Windows x64 Debug",
      "description": "Target Windows (64-bit) with the Visual Studio development environment. (Debug)",
      "inherits": "windows-msbuild",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "win-x64-release",
      "displayName": "Windows x64 Release",
      "description": "Target Windows (64-bit) with the Visual Studio development environment (Release)",
      "inherits": "windows-msbuild",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "win-x64-cxx20-debug",
      "displayName": "Windows x64 Debug with C++20 (Ninja)",
      "description": "Target Windows (64-bit) with Ninja (Debug) and C++20",
      "inherits": "windows-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "Draco_CXX_LANGUAGE_STANDARD": "20"
      }
    },
    {
      "name": "win-x64-cxx20-release",
      "displayName": "Windows x64 Release with C++20 (Ninja)",
      "description": "Target Windows (64-bit) with Ninja (Release) and C++20",
      "inherits": "windows-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "Draco_CXX_LANGUAGE_STANDARD": "20"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-x64-debug",
      "configurePreset": "win-x64-debug"
    },
    {
      "name": "win-x64-release",
      "configurePreset": "win-x64-release"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-debug-scalar",
      "configurePreset": "linux-debug-scalar"
    },
    {
      "name": "linux-debug-fd-static",
      "configurePreset": "linux-debug-fd-static"
    },
    {
      "name": "linux-debug-valgrind",
      "configurePreset": "linux-debug-valgrind"
    },
    {
      "name": "linux-debug-cxx20",
      "configurePreset": "linux-debug-cxx20"
    },
    {
      "name": "linux-debug-clang-tidy",
      "configurePreset": "linux-debug-clang-tidy"
    },
    {
      "name": "venado-debug",
      "configurePreset": "venado-debug"
    },
    {
      "name": "darwin-haswell-debug",
      "configurePreset": "darwin-haswell-debug"
    },
    {
      "name": "darwin-haswell-release",
      "configurePreset": "darwin-haswell-release"
    },
    {
      "name": "darwin-haswell-clang-tidy",
      "configurePreset": "darwin-haswell-clang-tidy"
    }
  ],
  "testPresets": [
    {
      "name": "linux-ctest",
      "description": "Run all tests",
      "displayName": "Run all tests in parallel with ctest",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}-$env{SLURM_CLUSTER_NAME}",
        "rhs": "Linux-"
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true,
        "jobs": 24
      }
    },
    {
      "name": "linux-debug",
      "inherits": "linux-ctest",
      "description": "Run all tests",
      "displayName": "Ctest",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "inherits": "linux-ctest",
      "description": "Run all tests",
      "displayName": "Ctest",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-debug-scalar",
      "inherits": "linux-ctest",
      "description": "Run all tests",
      "displayName": "Ctest",
      "configurePreset": "linux-debug-scalar"
    },
    {
      "name": "linux-debug-fd-static",
      "inherits": "linux-ctest",
      "description": "Run all tests",
      "displayName": "Ctest",
      "configurePreset": "linux-debug-fd-static"
    },
    {
      "name": "linux-debug-cxx20",
      "inherits": "linux-ctest",
      "description": "Run all tests",
      "displayName": "Ctest",
      "configurePreset": "linux-debug-cxx20"
    },
    {
      "name": "linux-debug-clang-tidy",
      "inherits": "linux-ctest",
      "description": "Run all tests",
      "displayName": "Ctest",
      "configurePreset": "linux-debug-clang-tidy",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "stopOnFailure": true
      }
    },
    {
      "name": "venado-ctest",
      "displayName": "Run all tests",
      "description": "Run all tests in parallel with ctest",
      "hidden": true,
      "condition": {
        "type": "inList",
        "string": "$env{SLURM_CLUSTER_NAME}-$env{SLURM_JOB_PARTITION}",
        "list": [
          "venado-standard",
          "venado-gpu"
        ]
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    },
    {
      "name": "venado-debug",
      "inherits": "venado-ctest",
      "description": "Run all tests",
      "displayName": "Ctest",
      "configurePreset": "venado-debug"
    },
    {
      "name": "darwin-haswell-ctest",
      "displayName": "Run all tests",
      "description": "Run all tests in parallel with ctest",
      "hidden": true,
      "condition": {
        "type": "inList",
        "string": "$env{SLURM_CLUSTER_NAME}-$env{SLURM_JOB_PARTITION}",
        "list": [
          "darwin-general",
          "darwin-sid-spr"
        ]
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    },
    {
      "name": "darwin-haswell-release",
      "inherits": "darwin-haswell-ctest",
      "description": "Run all tests",
      "displayName": "Ctest",
      "configurePreset": "darwin-haswell-release"
    },
    {
      "name": "darwin-haswell-debug",
      "inherits": "darwin-haswell-ctest",
      "description": "Run all tests",
      "displayName": "Ctest",
      "configurePreset": "darwin-haswell-debug"
    },
    {
      "name": "windows-ctest",
      "description": "Run all tests",
      "displayName": "Ctest",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true,
        "jobs": 24
      }
    },
    {
      "name": "win-x64-debug",
      "inherits": "windows-ctest",
      "configurePreset": "win-x64-debug",
      "configuration": "Debug",
      "displayName": "Ctest"
    },
    {
      "name": "win-x64-release",
      "inherits": "windows-ctest",
      "configurePreset": "win-x64-release",
      "configuration": "Release",
      "displayName": "Ctest"
    }
  ],
  "workflowPresets": [
    {
      "name": "linux-debug",
      "steps": [
        {
          "type": "configure",
          "name": "linux-debug"
        },
        {
          "type": "build",
          "name": "linux-debug"
        },
        {
          "type": "test",
          "name": "linux-debug"
        }
      ]
    }
  ]
}