{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 26,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-ninja",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}-$env{SLURM_CLUSTER_NAME}",
        "rhs": "Linux-"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "description": "Target Linux for Debug build.",
      "inherits": "linux-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "description": "Target Linux for Release build.",
      "inherits": "linux-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-debug-scalar",
      "displayName": "Linux Debug (No MPI)",
      "description": "Target Linux for Debug build.",
      "inherits": "linux-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DRACO_C4": "SCALAR",
        "DRACO_DIAGNOSTICS": "2"
      }
    },
    {
      "name": "linux-debug-fd-static",
      "displayName": "Linux Debug (Full Diagnostics, static libraries)",
      "description": "Target Linux for Debug build.",
      "inherits": "linux-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DRACO_DIAGNOSTICS": "7",
        "DRACO_TIMING": "1",
        "DRACO_LIBRARY_TYPE": "STATIC"
      }
    },
    {
      "name": "linux-debug-valgrind",
      "displayName": "Linux Debug (Valgrind memory analysis)",
      "description": "Target Linux for Debug build.",
      "inherits": "linux-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-march=broadwell",
        "CMAKE_Fortran_FLAGS": "-march=broadwell",
        "ENABLE_MEMORYCHECK": "ON",
        "CTEST_MEMORYCHECK_SUPPRESSIONS_FILE": "${sourceDir}/.gitlab/ci/valgrind_suppress.txt"
      }
    },
    {
      "name": "linux-debug-coverage",
      "displayName": "Linux Debug with coverage reporting",
      "description": "Target Linux for Debug build.",
      "inherits": "linux-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CODE_COVERAGE": "ON"
      }
    },
    {
      "name": "linux-debug-cxx23",
      "displayName": "Linux Debug with C++23 enabled",
      "description": "Target Linux for Debug build.",
      "inherits": "linux-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "Draco_CXX_LANGUAGE_STANDARD": "23"
      }
    },
    {
      "name": "linux-debug-clang-tidy",
      "displayName": "Linux Debug (Clang Tidy)",
      "description": "Target Linux for Debug build.",
      "inherits": "linux-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DRACO_STATIC_ANALYZER": "clang-tidy",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      },
      "condition": {
        "type": "matches",
        "string": "$env{CC}",
        "regex": "clang"
      }
    },
    {
      "name": "slurm-cn",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}-$env{SLURM_JOB_PARTITION}",
      "installDir": "${sourceDir}/install/${presetName}-$env{SLURM_JOB_PARTITION}",
      "condition": {
        "type": "inList",
        "string": "$env{SLURM_CLUSTER_NAME}-$env{SLURM_JOB_PARTITION}",
        "list": [
          "darwin-general",
          "darwin-sid-spr",
          "darwin-volta-x86",
          "rocinante-standard"
        ]
      }
    },
    {
      "name": "slurm-cn-debug",
      "displayName": "SLURM compute node Debug",
      "description": "Target Linux (slurm compute node) for Debug build.",
      "inherits": "slurm-cn",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "slurm-cn-release",
      "displayName": "SLURM compute node Release",
      "description": "Target Linux (slurm compute node) for Debug build.",
      "inherits": "slurm-cn",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "slurm-cn-debug-scalar",
      "displayName": "SLURM compute node Debug (No MPI)",
      "description": "Target Linux (slurm compute node) for Debug build.",
      "inherits": "slurm-cn",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DRACO_C4": "SCALAR",
        "DRACO_DIAGNOSTICS": "2"
      }
    },
    {
      "name": "slurm-cn-debug-fd-static",
      "displayName": "SLURM compute node Debug (Full Diagnostics, static libraries)",
      "description": "Target Linux (slurm compute node) for Debug build.",
      "inherits": "slurm-cn",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DRACO_DIAGNOSTICS": "7",
        "DRACO_TIMING": "1",
        "DRACO_LIBRARY_TYPE": "STATIC"
      }
    },
    {
      "name": "slurm-cn-debug-cxx23",
      "displayName": "SLURM  compute node Debug with C++23 enabled",
      "description": "Target Linux (slurm compute node) for Debug build.",
      "inherits": "slurm-cn",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "Draco_CXX_LANGUAGE_STANDARD": "23"
      }
    },
    {
      "name": "slurm-cn-clang-tidy",
      "displayName": "SLURM compute node Debug (Clang Tidy)",
      "description": "Target Linux (slurm compute node) for Debug build.",
      "inherits": "slurm-cn",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DRACO_STATIC_ANALYZER": "clang-tidy"
      },
      "condition": {
      "type": "allOf",
      "conditions": [
        {
          "type": "matches",
          "string": "$env{CC}",
          "regex": "clang"
        },
        {
          "type": "inList",
          "string": "$env{SLURM_CLUSTER_NAME}-$env{SLURM_JOB_PARTITION}",
          "list": [
            "darwin-general",
            "darwin-sid-spr",
            "darwin-volta-x86",
            "rocinante-standard"
          ]
        }
      ]
    }
    },
    {
      "name": "macos-debug",
      "displayName": "macOS Debug",
      "description": "Target a remote macOS system.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "windows-msbuild",
      "description": "Target Windows with the Visual Studio development environment.",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.gitlab/ci/vs2022-toolchain.cmake"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-ninja",
      "description": "Target Windows with Ninja",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "DRACO_LIBRARY_TYPE": "SHARED",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.gitlab/ci/vs2022-toolchain.cmake",
        "CMAKE_MAKE_PROGRAM": "C:/Program Files/Microsoft Visual Studio/2022/Professional/Common7/IDE/CommonExtensions/Microsoft/CMake/Ninja/ninja.exe"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "win-x64-debug",
      "displayName": "Windows x64 Debug",
      "description": "Target Windows (64-bit) with the Visual Studio development environment. (Debug)",
      "inherits": "windows-msbuild",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "win-x64-release",
      "displayName": "Windows x64 Release",
      "description": "Target Windows (64-bit) with the Visual Studio development environment (Release)",
      "inherits": "windows-msbuild",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "win-x64-cxx23-debug",
      "displayName": "Windows x64 Debug with C++23 (Ninja)",
      "description": "Target Windows (64-bit) with Ninja (Debug) and C++23",
      "inherits": "windows-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "Draco_CXX_LANGUAGE_STANDARD": "23"
      }
    },
    {
      "name": "win-x64-cxx23-release",
      "displayName": "Windows x64 Release with C++23 (Ninja)",
      "description": "Target Windows (64-bit) with Ninja (Release) and C++23",
      "inherits": "windows-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "Draco_CXX_LANGUAGE_STANDARD": "23"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-x64-debug",
      "configurePreset": "win-x64-debug"
    },
    {
      "name": "win-x64-release",
      "configurePreset": "win-x64-release"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-debug-scalar",
      "configurePreset": "linux-debug-scalar"
    },
    {
      "name": "linux-debug-fd-static",
      "configurePreset": "linux-debug-fd-static"
    },
    {
      "name": "linux-debug-valgrind",
      "configurePreset": "linux-debug-valgrind"
    },
    {
      "name": "linux-debug-coverage",
      "configurePreset": "linux-debug-coverage"
    },
    {
      "name": "linux-debug-cxx23",
      "configurePreset": "linux-debug-cxx23"
    },
    {
      "name": "linux-debug-clang-tidy",
      "configurePreset": "linux-debug-clang-tidy"
    },
    {
      "name": "slurm-cn-debug",
      "configurePreset": "slurm-cn-debug"
    },
    {
      "name": "slurm-cn-release",
      "configurePreset": "slurm-cn-release"
    },
    {
      "name": "slurm-cn-debug-scalar",
      "configurePreset": "slurm-cn-debug-scalar"
    },
    {
      "name": "slurm-cn-debug-cxx23",
      "configurePreset": "slurm-cn-debug-cxx23"
    },
    {
      "name": "slurm-cn-debug-fd-static",
      "configurePreset": "slurm-cn-debug-fd-static"
    },
    {
      "name": "slurm-cn-clang-tidy",
      "configurePreset": "slurm-cn-clang-tidy"
    }
  ],
  "testPresets": [
    {
      "name": "linux-ctest",
      "description": "Run all tests",
      "displayName": "Run all tests in parallel with ctest",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}-$env{SLURM_CLUSTER_NAME}",
        "rhs": "Linux-"
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    },
    {
      "name": "linux-debug",
      "inherits": "linux-ctest",
      "description": "Run all tests",
      "displayName": "Ctest",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "inherits": "linux-ctest",
      "description": "Run all tests",
      "displayName": "Ctest",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-debug-scalar",
      "inherits": "linux-ctest",
      "description": "Run all tests",
      "displayName": "Ctest",
      "configurePreset": "linux-debug-scalar"
    },
    {
      "name": "linux-debug-fd-static",
      "inherits": "linux-ctest",
      "description": "Run all tests",
      "displayName": "Ctest",
      "configurePreset": "linux-debug-fd-static"
    },
    {
      "name": "linux-debug-cxx23",
      "inherits": "linux-ctest",
      "description": "Run all tests",
      "displayName": "Ctest",
      "configurePreset": "linux-debug-cxx23"
    },
    {
      "name": "linux-debug-valgrind",
      "inherits": "linux-ctest",
      "description": "Run all tests under valgrind",
      "displayName": "Ctest with valgrind dynamic analysis",
      "configurePreset": "linux-debug-valgrind",
      "filter": {
        "include": {
          "name": "memcheck_",
          "label": "memcheck"
        },
        "exclude": {
          "name": "lightweight"
        }
      }
    },
    {
      "name": "linux-debug-coverage",
      "inherits": "linux-ctest",
      "description": "Collect coverage (gcov) data when running tests",
      "displayName": "CTest when gcov enabled.",
      "configurePreset": "linux-debug-coverage"
    },
    {
      "name": "linux-debug-clang-tidy",
      "inherits": "linux-ctest",
      "description": "Run all tests",
      "displayName": "Ctest",
      "configurePreset": "linux-debug-clang-tidy",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "stopOnFailure": true
      }
    },
    {
      "name": "slurm-cn-ctest",
      "displayName": "Run all tests",
      "description": "Run all tests in parallel with ctest",
      "hidden": true,
      "condition": {
        "type": "inList",
        "string": "$env{SLURM_CLUSTER_NAME}-$env{SLURM_JOB_PARTITION}",
        "list": [
          "darwin-general",
          "darwin-sid-spr",
          "darwin-volta-x86",
          "rocinante-standard"
        ]
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    },
    {
      "name": "slurm-cn-release",
      "inherits": "slurm-cn-ctest",
      "description": "Run all tests",
      "displayName": "Ctest",
      "configurePreset": "slurm-cn-release"
    },
    {
      "name": "slurm-cn-debug",
      "inherits": "slurm-cn-ctest",
      "description": "Run all tests",
      "displayName": "Ctest",
      "configurePreset": "slurm-cn-debug"
    },
    {
      "name": "slurm-cn-debug-scalar",
      "inherits": "slurm-cn-ctest",
      "description": "Run all tests",
      "displayName": "Ctest",
      "configurePreset": "slurm-cn-debug-scalar"
    },
    {
      "name": "slurm-cn-debug-fd-static",
      "inherits": "slurm-cn-ctest",
      "description": "Run all tests",
      "displayName": "Ctest",
      "configurePreset": "slurm-cn-debug-fd-static"
    },
    {
      "name": "slurm-cn-debug-cxx23",
      "inherits": "slurm-cn-ctest",
      "description": "Run all tests",
      "displayName": "Ctest",
      "configurePreset": "slurm-cn-debug-cxx23"
    },
    {
      "name": "windows-ctest",
      "description": "Run all tests",
      "displayName": "Ctest",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    },
    {
      "name": "win-x64-debug",
      "inherits": "windows-ctest",
      "configurePreset": "win-x64-debug",
      "configuration": "Debug",
      "displayName": "Ctest"
    },
    {
      "name": "win-x64-release",
      "inherits": "windows-ctest",
      "configurePreset": "win-x64-release",
      "configuration": "Release",
      "displayName": "Ctest"
    }
  ],
  "workflowPresets": [
    {
      "name": "linux-debug",
      "steps": [
        { "type": "configure", "name": "linux-debug" },
        { "type": "build", "name": "linux-debug" },
        { "type": "test", "name": "linux-debug" }
      ]
    },
    {
      "name": "linux-release",
      "steps": [
        { "type": "configure", "name": "linux-release" },
        { "type": "build", "name": "linux-release" },
        { "type": "test", "name": "linux-release" }
      ]
    }
  ]
}
