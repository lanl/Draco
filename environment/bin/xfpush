#!/bin/bash
# ------------------------------------------------------------------------------------------------ #
# File  : environment/bin/xfpush
# Date  : Tuesday, May 31, 2016, 14:48 pm
# Author: Kelly Thompson
# Note  : Copyright (C) 2016-2021, Triad National Security, LLC., All rights are reserved.
#
# Transfer 2.0 (Mercury replacement), Ref: http://transfer.lanl.gov
#
# Examples:
#   xfpush foo.txt
#   xfstatus
#   xfpull foo.txt
# ------------------------------------------------------------------------------------------------ #

saveifs=$IFS
IFS=$(echo -en "\n\b")
myfiles="$*"
if ! test -n "$1"; then
    echo "ERROR: You must profile a file for transfering: xfpush foo.txt"
    return
fi
scp_opt=""
scpvers=$(ssh -V 2>&1 | sed -n 's/.*OpenSSH_\([0-9]*\).*/\1/p')
if [[ scpvers -ge 9 ]]; then
  scp_opt+="-O"
fi
for myfile in $myfiles; do
    scp ${scp_opt} "${myfile}" red@transfer.lanl.gov:
    echo "scp ${scp_opt} $myfile red@transfer.lanl.gov:"
done
IFS=$saveifs
