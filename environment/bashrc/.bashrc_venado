##-*- Mode: sh -*-
# ------------------------------------------------------------------------------------------------ #
#  .bashrc_venado
# ------------------------------------------------------------------------------------------------ #

[[ -n "$verbose" ]] && echo "In draco/environment/bashrc/.bashrc_venado"

# ------------------------------------------------------------------------------------------------ #
# ENVIRONMENTS
# ------------------------------------------------------------------------------------------------ #

# unlimit stack and core dump sizes.
ulimit -s unlimited

#
# MODULES
#

# 1. Determine if the module command is available
modcmd=`declare -f module`
# If not found, look for it in /usr/share/Modules
if [[ ! ${modcmd} ]]; then
  source /usr/share/lmod/lmod/init/bash || die \
    "ERROR: The module command was not found. No modules will be loaded (venado e01)."
fi
modcmd=`declare -f module`

# 2. Use modules found in the draco directory
if [[ ! ${modcmd} ]]; then
  echo "ERROR: The module command was not found. No modules will be loaded (venado e02)."
else
  module use --append /usr/projects/draco/Modules/venado
  [[ ${LOADEDMODULES} =~ "PrgEnv-cray" ]] && module swap PrgEnv-cray PrgEnv-gnu
  module load lapse/2.6.0-gnu
fi

# Do not escape $ for bash completion
shopt -s direxpand

# ------------------------------------------------------------------------------------------------ #
# End
# ------------------------------------------------------------------------------------------------ #
