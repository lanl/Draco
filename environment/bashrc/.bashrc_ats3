##-*- Mode: sh -*-
# ------------------------------------------------------------------------------------------------ #
#  .bashrc_ats3 - my bash configuration file upon bash login
# ------------------------------------------------------------------------------------------------ #

[[ "${verbose:-false}" == "true" ]] && echo "in draco/environment/bashrc/.bashrc_ats3"

# ------------------------------------------------------------------------------------------------ #
# ENVIRONMENTS
# ------------------------------------------------------------------------------------------------ #

# unlimit stack and core dump sizes.
ulimit -s unlimited

#
# MODULES
#

# 1. Determine if the module command is available
modcmd=`declare -f module`
# If not found, look for it in /usr/share/Modules
if [[ ! ${modcmd} ]]; then
  source /usr/share/lmod/lmod/init/bash || die \
    "ERROR: The module command was not found. No modules will be loaded (ats-3 e01)."
fi
modcmd=`declare -f module`

# 2. Use modules found in the draco directory
if [[ ! ${modcmd} ]]; then
  echo "ERROR: The module command was not found. No modules will be loaded (ats-3 e02)."
else
  module use --append /usr/projects/draco/Modules/ats3
  module load PrgEnv-gnu
  module load lapse/3.0.1-gnu
fi

# Do not escape $ for bash completion
shopt -s direxpand

[[ "${verbose}" == "true" ]] && echo "in draco/environment/bashrc/.bashrc_ats3 ... done"

# ------------------------------------------------------------------------------------------------ #
# End
# ------------------------------------------------------------------------------------------------ #
