   SN rbox SN [label="CTS-1", textbgcolour="#ff7f7f"],
   TT rbox TT [label="Trinitite", textbgcolour="#ff7f7f"],
   Sierra rbox Sierra [label="Sierra", textbgcolour="#ff7f7f"],
   ElCap rbox ElCap [label="El Capitan", textbgcolour="#00CC33"],
   xrds rbox xrds [label="Crossroads", textbgcolour="#00CC33"],
   CTS2 rbox CTS2 [label="CTS-2/Roci", textbgcolour="#00CC33"],
   Venado rbox Venado [label="Venado", textbgcolour="#00CC33"],
   ATS5 rbox ATS5 [label="ATS-5", textbgcolour="#ffff9f"];

   # Version support (one per line, semicolon)
   ML abox TT [label="Draco-6_24_0", textbgcolor="#ff7f7f"];
   SN abox TT [label="Draco-7_0_0", textbgcolor="#ffff9f"];
   SN abox SN [label="Draco-7_18_0", textbgcolor="#ffff9f"],
   SN abox SN [label="Draco-7_19_0", textbgcolor="#ffff9f"],
   Sierra abox CTS2 [label="Draco-7_19_0", textbgcolor="#ffff9f"];
   ElCap rbox CTS2 [label="Draco-7_21_0", textbgcolor="#00CC33"];
