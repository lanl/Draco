   CTS2 rbox CTS2 [label="CTS-2/Roci", textbgcolour="#006e33"];

   # Version support (one per line, semicolon)
   ML abox TT [label="Draco-6_24_0", textbgcolor="#ffff9f"];
   ML abox TT [label="Draco-6_23_0", textbgcolor="#ffff9f"];
   ML abox TT [label="Draco-6_22_0", textbgcolor="#ffff9f"];
